# ==============================================================================
# Build With Agora Hackathon - Employee Productivity Assistant Backend Configuration
# ==============================================================================

# Server Configuration
PORT=4040
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_SECRET=super-secret-employee-assistant-jwt-key-2026

# Neon PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Agora Conversational AI & RTC
AGORA_APP_ID=sample_agora_app_id
AGORA_APP_CERTIFICATE=sample_agora_app_certificate
AGORA_CUSTOMER_ID=sample_agora_customer_id
AGORA_CUSTOMER_SECRET=sample_agora_customer_secret

# Murf AI Falcon TTS
MURF_API_KEY=sample_murf_api_key
MURF_FALCON_VOICE_ID=en-US-natalie

# Google Gemini LLM API (Interactions API Endpoint)
GEMINI_API_KEY=sample_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# GitHub REST API
GITHUB_TOKEN=sample_github_token
DEFAULT_GITHUB_REPO=thecodephilic-guy/doc-assistant

# Email Notification (Resend or Nodemailer)
RESEND_API_KEY=re_sample_resend_key
EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
